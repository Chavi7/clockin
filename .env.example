# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
#
# In Portainer these are set as stack Environment variables instead of a file;
# the names are identical.

# REQUIRED. Long random string used to sign session cookies.
# The app refuses to start if this is blank, left as the placeholder above, or
# shorter than 16 characters.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
CLOCKIN_SECRET=replace-with-a-long-random-string

# Optional. Shared secret for the Inventory Manager roster sync API
# (/api/roster). Must match CLOCKIN_API_KEY on the inventory-manager container.
# Leave unset to disable the API entirely — there is no default.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
CLOCKIN_API_KEY=replace-with-a-long-random-string

# Host port. Default 5000.
CLOCKIN_PORT=5000

# Container timezone. Without it the container runs in UTC: a scan at 12:42 EDT
# is stored and exported as 16:42, and "today" rolls over at 8pm local.
TZ=America/New_York

# Host address the container is published on.
#   127.0.0.1 (default) — only the server itself can reach it. Correct behind a
#                         reverse proxy.
#   0.0.0.0             — reachable from classroom PCs. Required for a kiosk
#                         that students use from another computer.
CLOCKIN_BIND=127.0.0.1
