# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Long random string used to sign session cookies.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
CLOCKIN_SECRET=replace-with-a-long-random-string

# Shared secret for the Inventory Manager roster sync API (/api/roster).
# Must match CLOCKIN_API_KEY set on the inventory-manager container.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
CLOCKIN_API_KEY=replace-with-a-long-random-string

# Port the server listens on (default 5000)
CLOCKIN_PORT=5000
